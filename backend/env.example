# =====================================================
# Sondos AI Backend — Environment Variables
# =====================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# ⚠️ NEVER commit .env to git!
# =====================================================

# ── Server ──
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──
MONGO_DB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sondos-portal
DB_NAME=sondos-portal

# ── Redis (for queues & caching) ──
REDIS_URL=redis://localhost:6379

# ── Qdrant (Vector DB for RAG) ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── JWT ──
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=GENERATE_WITH_openssl_rand_hex_64

# ── S3 / DigitalOcean Spaces (File Storage) ──
S3_ENDPOINT=https://REGION.digitaloceanspaces.com
S3_BUCKET=sondos-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── Moyasar Payment Gateway ──
MOYASAR_PUBLISHABLE_KEY=pk_test_XXXXXXXXX
MOYASAR_SECRET_KEY=sk_test_XXXXXXXXX
MOYASAR_WEBHOOK_SECRET=

# ── LiveKit Voice Agent ──
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── OpenAI (for RAG embeddings & analysis) ──
OPENAI_API_KEY=sk-XXXXXXXXX

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sondos.ai

# ── Twilio (SMS & Phone) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Telnyx (Alternative Phone Provider) ──
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

# ── ElevenLabs (Voice Cloning) ──
ELEVENLABS_API_KEY=

# ── Sentry (Error Tracking) ──
SENTRY_DSN=

# ── Admin Seed ──
ADMIN_SEED_PASSWORD=CHANGE_ME_IMMEDIATELY
