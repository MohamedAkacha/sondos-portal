# ══════════════════════════════════════════════════════
# Sondos AI — Agent Worker Environment Variables
# LiveKit Agents 1.5
# ══════════════════════════════════════════════════════

# LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Deepgram (STT — Speech to Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI (LLM + TTS)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs (TTS — with voice cloning support)
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# Sondos Backend (for saving transcript)
SONDOS_BACKEND_URL=https://your-backend-url.com
SONDOS_AGENT_SECRET=your_shared_secret_here
